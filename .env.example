# Réglages pour docker-compose.desktop.yml (Docker Desktop sur Windows ou Mac).
# Copiez ce fichier en « .env » puis adaptez les chemins.
#
# Windows : utilisez des barres « / »   ex. C:/Users/Moi/Videos/Films
# Mac     :                             ex. /Users/moi/Movies

VENUS_MOVIES=./media/films
VENUS_SHOWS=./media/series
VENUS_ANIME=./media/animes
VENUS_CLIPS=./media/clips

# Port de Venus sur cette machine
VENUS_PORT=8096

# Début de l'adresse de votre réseau local (pour trouver vos NAS automatiquement)
LAN_SUBNET=192.168.1

TZ=Europe/Paris
# TMDB_API_KEY=votre_cle
